# ===== Database Configuration =====
DB_URL=jdbc:mysql://localhost:3306/mini_ecommerce
DB_USERNAME=mini_ecommerce_app
DB_PASSWORD=your_database_password

# ===== Admin Account Configuration =====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password

# Optional: activate Spring Boot development profile
# SPRING_PROFILES_ACTIVE=dev

# ===== CORS Configuration =====
# Comma-separated frontend origins; leave empty until frontend integration.
# Example: CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOWED_ORIGINS=

# ===== JWT Configuration =====
# Replace with a securely generated Base64-encoded 32-byte secret.
JWT_SECRET=replace_with_base64_encoded_32_byte_secret
