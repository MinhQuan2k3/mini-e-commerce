             },
    "item":  [
                 {
                     "name":  "Authentication",
                     "item":  [
                                  {
                                      "name":  "Register Customer",
                                      "request":  {
                                                      "method":  "POST",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Content-Type",
                                                                         "value":  "application/json"
                                                                     }
                                                                 ],
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\n  \"email\": \"postman-{{$timestamp}}@example.com\",\n  \"password\": \"Customer123\"\n}"
                                                               },
                                                      "url":  "{{baseUrl}}/auth/register"
                                                  },
                                      "event":  [
                                                    {
                                                        "listen":  "test",
                                                        "script":  {
                                                                       "type":  "text/javascript",
                                                                       "exec":  [
                                                                                    "pm.test(\u0027Status is 201 Created\u0027, function () {",
                                                                                    "    pm.response.to.have.status(201);",
                                                                                    "});",
                                                                                    "pm.test(\u0027Response contains registered customer data\u0027, function () {",
                                                                                    "    const response = pm.response.json();",
                                                                                    "    pm.expect(response.success).to.eql(true);",
                                                                                    "    pm.expect(response.data).to.have.property(\u0027id\u0027);",
                                                                                    "    pm.expect(response.data).to.have.property(\u0027email\u0027);",
                                                                                    "    pm.expect(response.data).to.have.property(\u0027role\u0027);",
                                                                                    "});"
                                                                                ]
                                                                   }
                                                    }
                                                ]
                                  }
                              ]
