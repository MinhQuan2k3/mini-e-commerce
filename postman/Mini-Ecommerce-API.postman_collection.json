{
  "info": {
    "_postman_id": "mini-ecommerce-api-collection",
    "name": "Mini E-commerce API",
    "description": "Postman collection for testing the Mini E-commerce backend APIs. Uses the Mini E-commerce - Local environment.\n\n**Authentication:**\n- Authentication endpoints support Customer registration and login.\n- Admin login and Customer login return JWT access tokens.\n- Access tokens are automatically saved to the active Postman environment.\n- Admin Categories, Admin Products, and Cleanup folders use the Admin Bearer Token.\n- Protected endpoints require a valid JWT.\n- Customer and Admin access permissions are tested separately.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', function () {\n    pm.response.to.have.status(201);\n});\n\npm.test('Response contains registered customer data', function () {\n    const response = pm.response.json();\n\n    pm.expect(response.success).to.eql(true);\n    pm.expect(response.data).to.have.property('id');\n    pm.expect(response.data).to.have.property('email');\n    pm.expect(response.data).to.have.property('role');\n\n    pm.expect(response.data.role).to.eql('CUSTOMER');\n\n    // Save the registered customer email for the login request.\n    pm.environment.set('customerEmail', response.data.email);\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman-{{$timestamp}}@example.com\",\n  \"password\": \"Customer123\"\n}",
              "options": {
                "raw": {
                  "language": "text"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test('Login response contains valid Customer JWT', function () {\r\n    const response = pm.response.json();\r\n\r\n    pm.expect(response.success).to.eql(true);\r\n    pm.expect(response.data.accessToken).to.be.a('string').and.not.empty;\r\n    pm.expect(response.data.tokenType).to.eql('Bearer');\r\n    pm.expect(response.data.expiresIn).to.eql(3600);\r\n    pm.expect(response.data.user.role).to.eql('CUSTOMER');\r\n    pm.expect(response.data.user.email).to.eql(\r\n        pm.environment.get('customerEmail')\r\n    );\r\n\r\n    pm.environment.set(\r\n        'customerAccessToken',\r\n        response.data.accessToken\r\n    );\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"{{customerEmail}}\",\r\n  \"password\": \"Customer123\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test('Login response contains valid Admin JWT', function () {\r\n    const response = pm.response.json();\r\n\r\n    pm.expect(response.success).to.eql(true);\r\n    pm.expect(response.data.accessToken).to.be.a('string').and.not.empty;\r\n    pm.expect(response.data.tokenType).to.eql('Bearer');\r\n    pm.expect(response.data.expiresIn).to.eql(3600);\r\n\r\n    pm.expect(response.data.user.id).to.eql(1);\r\n    pm.expect(response.data.user.email).to.eql(\r\n        pm.environment.get('adminEmail')\r\n    );\r\n    pm.expect(response.data.user.role).to.eql('ADMIN');\r\n\r\n    pm.environment.set(\r\n        'adminAccessToken',\r\n        response.data.accessToken\r\n    );\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"{{adminEmail}}\",\r\n  \"password\": \"{{adminPassword}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Current User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test('Current user matches authenticated Admin', function () {\r\n    const response = pm.response.json();\r\n\r\n    pm.expect(response.success).to.eql(true);\r\n    pm.expect(response.data.id).to.eql(1);\r\n    pm.expect(response.data.email).to.eql(\r\n        pm.environment.get('adminEmail')\r\n    );\r\n    pm.expect(response.data.role).to.eql('ADMIN');\r\n\r\n    pm.expect(response.data).to.not.have.property('password');\r\n    pm.expect(response.data).to.not.have.property('passwordHash');\r\n});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Customer Access Admin API → 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 403 Forbidden', function () {\r\n    pm.response.to.have.status(403);\r\n});\r\n\r\npm.test('Customer is denied Admin API access with JSON response', function () {\r\n    const response = pm.response.json();\r\n\r\n    pm.expect(response.success).to.eql(false);\r\n    pm.expect(response.message).to.be.a('string').and.not.empty;\r\n});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
